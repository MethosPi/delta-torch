{
  "name": "delta-torch",
  "version": "0.2.0",
  "description": "Save tokens, survive context limits, and resume coding tasks across CLI agents with portable markdown handoffs.",
  "type": "module",
  "bin": {
    "delta-torch": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "AGENTS.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "prepack": "pnpm build",
    "test": "pnpm build && vitest run"
  },
  "keywords": [
    "delta-torch",
    "ai-agents",
    "terminal-agent",
    "claude-code",
    "codex",
    "ollama",
    "skills",
    "handoff",
    "checkpoint",
    "cli",
    "resume"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MethosPi/delta-torch.git"
  },
  "homepage": "https://github.com/MethosPi/delta-torch#readme",
  "bugs": {
    "url": "https://github.com/MethosPi/delta-torch/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
